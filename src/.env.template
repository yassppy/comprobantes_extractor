DATABASE_URL=postgresql://postgres:password@localhost:5432/name

# Nombre del modelo a usar para clasificación automática
# Ejemplos:
#   Ollama  → qwen3:1.7b
#   LM Studio → qwen2.5-1.5b-instruct
MODEL=qwen2.5-1.5b-instruct

# URL base del servidor de inferencia local
# Ollama local    → http://localhost:11434
# Ollama Termux   → http://192.168.1.XX:11434
# LM Studio local → http://localhost:1234
BASE_URL=http://localhost:1234

# Backend de inferencia: ollama | lmstudio
LLM_BACKEND=lmstudio
LLM_TIMEOUT=120
